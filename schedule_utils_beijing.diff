  import numpy as np
  import pandas as pd
  from scipy.stats import skewnorm
  
  def build_schedules(arrival_times, max_waiting_time, occupancy):
      arrival_times = np.sort(arrival_times)
      scheduled_times = []
      num_pax_per_flight = []
      queue = []
      for t in arrival_times:
          queue.append(t)
          # If the first passenger has been waiting more than max_waiting_time or the queue is full, schedule a flight
          if (t - queue[0] > max_waiting_time) or (len(queue) >= occupancy):
              scheduled_times.append(t)
              num_pax_per_flight.append(len(queue))
              queue = []
      if queue:
          scheduled_times.append(queue[-1])
          num_pax_per_flight.append(len(queue))
      return np.array(scheduled_times), np.array(num_pax_per_flight)
